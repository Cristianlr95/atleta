# Entorno full-stack local. Copia a .env y reemplaza solo valores locales.
DB_NAME=atleta_dev
DB_USERNAME=atleta_dev
DB_PASSWORD=change-me-local-password
JWT_SECRET=replace-with-a-secure-secret-of-at-least-32-bytes
JWT_ISSUER=atleta-dev
DEV_SEED_ENABLED=true
DEV_SEED_PASSWORD=AtletaDev!2026
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:4201,http://localhost:8080
ATLETA_AI_ENABLED=false
ATLETA_AI_PROVIDER=disabled
ATLETA_AI_TIMEOUT=PT8S
ATLETA_ENV_NAME=development
ATLETA_API_BASE_URL=http://localhost:8080/api/v1
ATLETA_STORAGE_PREFIX=atleta.dev
